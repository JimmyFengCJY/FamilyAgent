# Copy to .env. scripts/start.py loads it automatically (file values take precedence).
# Direct uvicorn/worker/eval commands still require environment variables.
FAMILYAGENT_PROVIDER=demo
FAMILYAGENT_DEMO_LOGIN=1
FAMILYAGENT_DB=data/familyagent.sqlite3

# Actual model mode: API key stays on the server, never in VITE_* variables.
# FAMILYAGENT_PROVIDER=anthropic
# FAMILYAGENT_MODEL=<a model ID available to your account>
# ANTHROPIC_API_KEY=<your key>
# FAMILYAGENT_DEMO_LOGIN=0

# DeepSeek (native Chat Completions)
# FAMILYAGENT_PROVIDER=deepseek
# DEEPSEEK_MODEL=<a model ID available to your account>
# DEEPSEEK_API_KEY=<your key>

# Gemini (Google AI Studio / Gemini Developer API, not Vertex AI)
# FAMILYAGENT_PROVIDER=gemini
# GEMINI_MODEL=<a model ID available to your account>
# GEMINI_API_KEY=<your key>

# Provider-specific model variables also supported: ANTHROPIC_MODEL, DEEPSEEK_MODEL,
# GEMINI_MODEL. FAMILYAGENT_MODEL overrides them; unset it when switching providers.
# FAMILYAGENT_MAX_OUTPUT_TOKENS=1800
# FAMILYAGENT_MODEL_TIMEOUT=35

# Optional standalone Worker: set this to 0 for the API, then start worker.py separately.
# FAMILYAGENT_EMBEDDED_WORKER=0
# FAMILYAGENT_DEMO_DELAY=0.65
