# Copy to deploy/model.env. Do not quote values; raw format keeps them literal.
# This is NOT loaded by the default demo deployment.
FAMILYAGENT_PROVIDER=gemini
GEMINI_MODEL=<model ID available to your account>
GEMINI_API_KEY=<your key>
# FAMILYAGENT_PROVIDER=anthropic
# ANTHROPIC_MODEL=<model ID available to your account>
# ANTHROPIC_API_KEY=<your key>
# FAMILYAGENT_PROVIDER=deepseek
# DEEPSEEK_MODEL=<model ID available to your account>
# DEEPSEEK_API_KEY=<your key>

# Leave blank when using a provider-specific model, avoiding stale generic override.
FAMILYAGENT_MODEL=
FAMILYAGENT_MAX_OUTPUT_TOKENS=1800
FAMILYAGENT_MODEL_TIMEOUT=35
